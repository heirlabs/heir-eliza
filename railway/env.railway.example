# Railway Environment Variables Template
# Copy these to your Railway project's environment variables

# ===========================================
# REQUIRED - Set these in Railway Dashboard
# ===========================================

# MongoDB Connection (Railway MongoDB Plugin or MongoDB Atlas)
MONGODB_URI=mongodb://mongo:password@mongodb.railway.internal:27017/eliza?authSource=admin
MONGODB_DB_NAME=eliza

# OpenAI API Key (for LLM)
OPENAI_API_KEY=sk-your-openai-api-key

# ===========================================
# OPTIONAL - Application Configuration
# ===========================================

# Node environment
NODE_ENV=production

# Server port (Railway sets this automatically via PORT env)
PORT=3000

# Logging level
LOG_LEVEL=info

# Agent configuration
AGENT_ID=eliza-production

# ===========================================
# OPTIONAL - Database Configuration
# ===========================================

# PostgreSQL (if using SQL adapter instead of MongoDB)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ===========================================
# OPTIONAL - External Services
# ===========================================

# Venice AI (alternative LLM provider)
# VENICE_API_KEY=your-venice-api-key

# Twitter/X Integration
# TWITTER_API_KEY=your-twitter-api-key
# TWITTER_API_SECRET=your-twitter-api-secret
# TWITTER_ACCESS_TOKEN=your-access-token
# TWITTER_ACCESS_SECRET=your-access-secret

# Telegram Integration
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Discord Integration
# DISCORD_BOT_TOKEN=your-discord-bot-token

# ===========================================
# OPTIONAL - Security
# ===========================================

# Server authentication token
# ELIZA_SERVER_AUTH_TOKEN=your-secure-random-token

# Secret salt for encryption
# SECRET_SALT=your-secret-salt-value

